{
  "openapi": "3.0.3",
  "info": {
    "title": "Airbnb Traveler API",
    "version": "1.0.0",
    "description": "Traveler-facing endpoints: auth (session), profile, properties, bookings, favorites, health."
  },
  "servers": [
    { "url": "http://localhost:8000", "description": "Local Traveler" }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "about": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string", "example": "CA" },
          "country": { "type": "string", "example": "United States" },
          "languages": { "type": "array", "items": { "type": "string" } },
          "gender": { "type": "string" },
          "avatarUrl": { "type": "string" }
        }
      },
      "Property": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "amenities": { "type": "array", "items": { "type": "string" } },
          "price": { "type": "number" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "bedrooms": { "type": "integer" },
          "bathrooms": { "type": "integer" },
          "capacity": { "type": "integer" }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "propertyId": { "type": "integer" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "guests": { "type": "integer" },
          "status": { "type": "string", "enum": ["Pending", "Accepted", "Cancelled"] }
        }
      },
      "Favorite": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "propertyId": { "type": "integer" },
          "title": { "type": "string" },
          "city": { "type": "string" },
          "price": { "type": "number" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Service health",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Traveler signup",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              },
              "examples": {
                "default": {
                  "value": { "name": "Traveler Test", "email": "traveler1@example.com", "password": "Test1234!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login (sets session cookie)",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              },
              "examples": {
                "default": {
                  "value": { "email": "traveler1@example.com", "password": "Test1234!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "headers": { "Set-Cookie": { "description": "Session cookie", "schema": { "type": "string" } } } },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Logout (destroys session)",
        "tags": ["Auth"],
        "responses": {
          "204": { "description": "No Content" }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get my profile",
        "tags": ["Profile"],
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "summary": "Update my profile",
        "tags": ["Profile"],
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "phone": { "type": "string" },
                  "about": { "type": "string" },
                  "city": { "type": "string" },
                  "state": { "type": "string", "example": "CA" },
                  "country": { "type": "string", "example": "United States" },
                  "languages": { "type": "array", "items": { "type": "string" } },
                  "gender": { "type": "string" }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "name": "Traveler Test",
                    "email": "traveler1@example.com",
                    "phone": "+1-415-555-0101",
                    "about": "Love beach trips",
                    "city": "San Jose",
                    "state": "CA",
                    "country": "United States",
                    "languages": ["English", "Spanish"],
                    "gender": "Female"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/users/me/avatar": {
      "post": {
        "summary": "Upload profile picture",
        "tags": ["Profile"],
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "file": { "type": "string", "format": "binary" } },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/properties": {
      "get": {
        "summary": "Search/list properties",
        "tags": ["Properties"],
        "parameters": [
          { "name": "location", "in": "query", "schema": { "type": "string" } },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "guests", "in": "query", "schema": { "type": "integer", "minimum": 1 } }
        ],
        "responses": {
          "200": {
            "description": "List",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Property" } } } }
          }
        }
      }
    },
    "/api/properties/{id}": {
      "get": {
        "summary": "Property details",
        "tags": ["Properties"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Property" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "summary": "Create booking (Pending)",
        "tags": ["Bookings"],
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["propertyId", "startDate", "endDate", "guests"],
                "properties": {
                  "propertyId": { "type": "integer" },
                  "startDate": { "type": "string", "format": "date" },
                  "endDate": { "type": "string", "format": "date" },
                  "guests": { "type": "integer", "minimum": 1 }
                }
              },
              "examples": {
                "default": {
                  "value": { "propertyId": 123, "startDate": "2025-11-15", "endDate": "2025-11-18", "guests": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Booking" } } } },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Overlapping/Unavailable" }
        }
      },
      "get": {
        "summary": "List my bookings",
        "tags": ["Bookings"],
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["Pending", "Accepted", "Cancelled"] } },
          { "name": "scope", "in": "query", "schema": { "type": "string", "enum": ["past"] } }
        ],
        "responses": {
          "200": {
            "description": "List",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Booking" } } } }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/favorites": {
      "get": {
        "summary": "List favorites",
        "tags": ["Favorites"],
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "List",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Favorite" } } } }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Add favorite",
        "tags": ["Favorites"],
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["propertyId"], "properties": { "propertyId": { "type": "integer" } } },
              "examples": { "default": { "value": { "propertyId": 123 } } }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/favorites/{id}": {
      "delete": {
        "summary": "Remove favorite by id",
        "tags": ["Favorites"],
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "204": { "description": "No Content" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  }
}
